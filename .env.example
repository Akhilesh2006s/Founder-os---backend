NODE_ENV=production
PORT=5000
MONGO_URI=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# CORS: comma-separated EXACT origins (scheme + host, no trailing slash).
# Include your canonical production frontend + localhost when developing:
#
# CLIENT_ORIGIN=https://founder-os-frontend.vercel.app,http://localhost:3000
#
# Vercel preview URLs change every deployment. Add your team hostname suffix ONCE so all
# `*.YOUR-team.projects.vercel.app` previews match (comma-separated suffixes, no scheme):
#
# CLIENT_ORIGIN_SUFFIXES=akhilesh2006s-projects.vercel.app
#

CLIENT_ORIGIN=http://localhost:3000

# Optional; omit to skip suffix matching:
# CLIENT_ORIGIN_SUFFIXES=

# Set to true to disable automatic allow for any https://*.vercel.app origin (defaults to permissive).
# CLIENT_ORIGIN_STRICT=true

# Production deploy: NODE_ENV=production recommended.
#
# Cookies for Vercel→Railway: SameSite=None+Secure when NODE_ENV=production or COOKIE_SAMESITE_NONE=1.
# Override with COOKIE_SAMESITE_NONE=true if needed.
